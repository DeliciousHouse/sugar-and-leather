{
  "name": "sugar-and-leather",
  "private": true,
  "version": "1.0.1",
  "homepage": "https://sugarandleather.com/",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/seo-check.mjs && vite build && node scripts/seo-build.mjs",
    "preview": "vite preview",
    "seo:check": "node scripts/seo-check.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node scripts/typecheck-baseline.mjs",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.460.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.7",
    "yaml": "^2.9.0"
  }
}
